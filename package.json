{
  "name": "deckbuilder",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/gallery dev",
    "dev:window": "bun run --cwd apps/gallery dev:window",
    "start": "bun run --cwd apps/gallery start",
    "start:browser": "bun run --cwd apps/gallery start:browser",
    "build:web": "bun run --cwd apps/gallery build:web",
    "build": "bun run --cwd apps/gallery build",
    "typecheck": "bun scripts/typecheck.ts",
    "new": "bun packages/build/src/cli.ts new"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.2"
  }
}
