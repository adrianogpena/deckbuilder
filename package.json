{
  "name": "kedalion",
  "private": true,
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev": "bun run --cwd app dev",
    "dev:window": "bun run --cwd app dev:window",
    "dev:design": "bun scripts/dev-design.ts",
    "start": "bun run --cwd app start",
    "start:browser": "bun run --cwd app start:browser",
    "build:web": "bun run --cwd app build:web",
    "build": "bun run --cwd app build",
    "typecheck": "bun scripts/typecheck.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.2"
  }
}
